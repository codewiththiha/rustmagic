/*
@NAME = "Fixture Basic"
@DESCRIPTION = "Exercises every construct the compiler supports"
@FONTFAMILY = "Inter"
@HOTKEY = "CTRL+SHIFT+M"
@TRACK_CAPSLOCK = "TRUE"
@EAT_ALL_UNUSED_KEYS = "FALSE"
@US_LAYOUT_BASED = "FALSE"
@SMART_BACKSPACE = "TRUE"
@TREAT_CTRL_ALT_AS_RALT = "TRUE"
*/

// Variables, including one that refers to another.
$cons = U1000 + U1001 + U1002
$consU = $cons + "xyz"
$row1K = "qw"
$row1U = U1040 + U1041
$vowels = "ae"

// One character of a variable, and the row it came from.
$cons[*] => $1
$row1K[*] => $row1U[$1]

// Plain literals, in both quoting styles and as unicode points.
"ka" => U1000
'kb' => "\u1001"
$cons => U1002

// Not-in-variable, and the wildcard.
$vowels[^] => "z"
ANY => $1

// Virtual keys: delete, a shifted letter, a state toggle and AltGr.
<VK_BACK> => NULL
<VK_SHIFT & VK_KEY_A> => "A"
<VK_BACKSLASH & VK_ALT_GR> => U104B
('shape') + "1" => "one"
"9" => ('shape')

// Escapes inside strings.
"\t" => U0009
"\\\\" => U005C
