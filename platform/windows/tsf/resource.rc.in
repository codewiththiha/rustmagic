/*
 * resource.rc (generated from resource.rc.in) — the icon Language settings shows
 * next to "RustMagic" and the version stamp Explorer reads.
 *
 * The icon is rendered from packaging/brand/rustmagic.svg by icons.sh; it is not
 * in the repository. @ICON_NAME@ lives in the build directory and is found
 * through the include path CMake sets.
 */

#include <winver.h>
/* An absolute path: the generated copy lives in the build directory, and the
 * resource compiler does not inherit the include directories a C++ target sets,
 * so a bare name finds nothing but a file that happens to sit beside it. */
#include "@RUSTMAGIC_TSF_SOURCE@/resource_ids.h"

RUSTMAGIC_ICON ICON "@ICON_NAME@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RUSTMAGIC_FILEVERSION@
 PRODUCTVERSION @RUSTMAGIC_FILEVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RustMagic"
            VALUE "FileDescription", "RustMagic keyboard text service"
            VALUE "FileVersion", "@RUSTMAGIC_VERSION@"
            VALUE "InternalName", "RustMagicTSF"
            VALUE "OriginalFilename", "RustMagicTSF.dll"
            VALUE "ProductName", "RustMagic"
            VALUE "ProductVersion", "@RUSTMAGIC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
