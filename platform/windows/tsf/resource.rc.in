/*
 * resource.rc (generated from resource.rc.in) — the icon Language settings shows
 * next to "RustMagic" and the version stamp Explorer reads.
 *
 * The icon is rendered from packaging/brand/rustmagic.svg by icons.sh; it is not
 * in the repository. @ICON_NAME@ lives in the build directory and is found
 * through the include path CMake sets.
 */

#include <winver.h>
#include "resource_ids.h"

RUSTMAGIC_ICON ICON "@ICON_NAME@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RustMagic"
            VALUE "FileDescription", "RustMagic keyboard text service"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "RustMagicTSF"
            VALUE "OriginalFilename", "RustMagicTSF.dll"
            VALUE "ProductName", "RustMagic"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
