# Maintainer: RustMagic contributors
#
# Builds RustMagic from a release tarball. The `-git` package next to this file
# builds straight from the branch, which is what a development machine wants.
#
#   makepkg -si
#
# The package installs three things a Linux desktop interacts with:
#   * `rustmagic`        the window, for managing keyboards
#   * `rustmagic-ibus`   the input method IBus starts
#   * `rustmagic.xml`    the component file IBus reads to find it
# and libkm_ffi.so with its header, the C ABI another input method can use.

pkgname=rustmagic
pkgver=0.2.1
pkgrel=1
pkgdesc="Keyboard layout engine for Myanmar and other scripts, in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/codewiththiha/rustmagic"
license=('GPL-2.0-or-later')
depends=('gcc-libs' 'glibc' 'ibus')
makedepends=('cargo' 'rust')
checkdepends=('python')
provides=('keymagic')
conflicts=('keymagic' 'keymagic3')
options=('!lto' '!debug')
install=rustmagic.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=${RUSTUP_TOOLCHAIN:-stable}
    cargo build --release --locked --workspace \
        --package rustmagic --package rustmagic-cli --package rustmagic-ibus \
        --package km-ffi
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --release --locked --workspace
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/rustmagic "$pkgdir/usr/bin/rustmagic"
    install -Dm755 target/release/rustmagic-cli "$pkgdir/usr/bin/rustmagic-cli"
    install -Dm755 target/release/rustmagic-ibus "$pkgdir/usr/bin/rustmagic-ibus"

    install -Dm644 assets/ibus/rustmagic.xml \
        "$pkgdir/usr/share/ibus/component/rustmagic.xml"
    install -Dm644 packaging/linux/rustmagic.desktop \
        "$pkgdir/usr/share/applications/rustmagic.desktop"
    install -Dm644 packaging/linux/rustmagic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/rustmagic.svg"
    install -Dm644 packaging/linux/rustmagic-ibus.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/rustmagic-ibus.svg"

    # The C ABI, so another input-method framework can host the engine. It is
    # not a system library (no soname), so it lives in its own directory.
    install -Dm644 target/release/libkm_ffi.so \
        "$pkgdir/usr/lib/$pkgname/libkm_ffi.so"
    install -Dm644 crates/km-ffi/include/rustmagic.h \
        "$pkgdir/usr/include/rustmagic.h"

    # The bundled keyboards every install starts with; the app also carries them
    # inside the binary, so these are for anyone who wants the files.
    install -d "$pkgdir/usr/share/$pkgname/keyboards"
    install -m644 keyboards/bundled/*.km2 \
        "$pkgdir/usr/share/$pkgname/keyboards/"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 assets/fonts/OFL.txt \
        "$pkgdir/usr/share/licenses/$pkgname/OFL-NotoSansMyanmar.txt"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
