<?xml version="1.0" encoding="UTF-8"?>
<!--
  RustMagic for Windows as an MSI, for anyone deploying with Group Policy, Intune
  or `msiexec /i`. The Inno Setup .exe is the friendlier download; this is the
  one an administrator can push.

    candle.exe -dVersion=0.2.0 -out dist\rustmagic.wixobj packaging\windows\rustmagic.wxs
    light.exe -ext WixUIExtension -out dist\RustMagic-0.2.0-x64.msi dist\rustmagic.wixobj

  WiX 3 syntax, because that is what the Windows runners ship. File components
  use Guid="*", which WiX fills in from the path, so the same tree always
  produces the same component identity and upgrades replace rather than pile up.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="RustMagic $(var.Version)"
      Language="1033"
      Version="$(var.Version)"
      Manufacturer="RustMagic contributors"
      UpgradeCode="18CA1AAD-FF22-5DEA-9A9C-D692CE09B6FE">

    <!-- Platform says x64 in the summary information, which is what validation
         asks for once any component is 64-bit; candle is also told `-arch x64`,
         which is the supported way to say the same thing. -->
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Platform="x64"
             Description="Keyboard layout engine for Myanmar and other scripts" />
    <MajorUpgrade DowngradeErrorMessage="A newer RustMagic is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="RustMagicIcon" SourceFile="dist\brand\rustmagic.ico" />
    <Property Id="ARPPRODUCTICON" Value="RustMagicIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/codewiththiha/rustmagic" />
    <!-- ARPNOMODIFY is not set here: WixUI_InstallDir declares it, and two
         definitions of the same property are a duplicate symbol at link time. -->

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="RustMagic">
          <Directory Id="KeyboardsFolder" Name="keyboards" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="RustMagic" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="yes">
        <File Id="RustMagicExe" Source="dist\windows\rustmagic.exe" KeyPath="yes" />
      </Component>
      <Component Id="CommandLine" Guid="*" Win64="yes">
        <File Id="RustMagicCliExe" Source="dist\windows\rustmagic-cli.exe" KeyPath="yes" />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last"
                     Action="set" Permanent="no" System="yes" />
      </Component>
      <Component Id="CEngine" Guid="*" Win64="yes">
        <File Id="KmFfiDll" Source="dist\windows\km_ffi.dll" KeyPath="yes" />
      </Component>
      <Component Id="CTextService" Guid="*" Win64="yes">
        <File Id="RustMagicTSFDll" Source="dist\windows\RustMagicTSF.dll" KeyPath="yes" />
      </Component>
      <Component Id="CEngineHeader" Guid="*" Win64="yes">
        <File Id="RustMagicHeader" Source="dist\windows\rustmagic.h" KeyPath="yes" />
      </Component>
      <!-- One file per component: a generated guid (`*`) is only allowed when the
           keypath is the only file, or when the keypath is versioned and the rest
           are not. These files are neither, so they are separate components. -->
      <Component Id="CDocumentation" Guid="*" Win64="yes">
        <File Id="Readme" Source="dist\windows\README.md" KeyPath="yes" />
      </Component>
      <Component Id="CLicence" Guid="*" Win64="yes">
        <File Id="Licence" Source="dist\windows\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="CFontLicence" Guid="*" Win64="yes">
        <File Id="FontLicence" Source="dist\windows\OFL-NotoSansMyanmar.txt" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="KeyboardsFolder">
      <Component Id="KbPyidaungsu" Guid="*" Win64="yes">
        <File Id="FilePyidaungsu" Source="dist\windows\keyboards\pyidaungsu-mm.km2" KeyPath="yes" />
      </Component>
      <Component Id="KbMyWin" Guid="*" Win64="yes">
        <File Id="FileMyWin" Source="dist\windows\keyboards\my-win.km2" KeyPath="yes" />
      </Component>
      <Component Id="KbMyanSan" Guid="*" Win64="yes">
        <File Id="FileMyanSan" Source="dist\windows\keyboards\myansan.km2" KeyPath="yes" />
      </Component>
      <Component Id="KbZawgyi" Guid="*" Win64="yes">
        <File Id="FileZawgyi" Source="dist\windows\keyboards\zawgyi.km2" KeyPath="yes" />
      </Component>
      <Component Id="KbZawCode" Guid="*" Win64="yes">
        <File Id="FileZawCode" Source="dist\windows\keyboards\zawcode.km2" KeyPath="yes" />
      </Component>
      <Component Id="KbMyanmar3" Guid="*" Win64="yes">
        <File Id="FileMyanmar3" Source="dist\windows\keyboards\myanmar3.km2" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="StartMenuShortcut" Name="RustMagic"
                  Description="Keyboard layout engine"
                  Target="[INSTALLFOLDER]rustmagic.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\RustMagic" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Win64="yes">
        <Shortcut Id="DesktopShortcut" Name="RustMagic"
                  Description="Keyboard layout engine"
                  Target="[INSTALLFOLDER]rustmagic.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RustMagic" Name="desktop"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="RustMagic" Level="1" Absent="disallow">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="CommandLine" />
      <ComponentRef Id="CEngine" />
      <ComponentRef Id="CTextService" />
      <ComponentRef Id="CEngineHeader" />
      <ComponentRef Id="CDocumentation" />
      <ComponentRef Id="CLicence" />
      <ComponentRef Id="CFontLicence" />
      <ComponentRef Id="KbPyidaungsu" />
      <ComponentRef Id="KbMyWin" />
      <ComponentRef Id="KbMyanSan" />
      <ComponentRef Id="KbZawgyi" />
      <ComponentRef Id="KbZawCode" />
      <ComponentRef Id="KbMyanmar3" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- The text service has to tell Windows about itself, and the only honest
         way to do that is its own DllRegisterServer: it writes the CLSID, the
         language profile and the keyboard category together, via the same TSF
         APIs the Inno build calls through regsvr32.

         The command line is built while the installer is still immediate, because
         a deferred action cannot read [INSTALLFOLDER] for itself; WixQuietExec64
         then runs that line elevated, which regsvr32 needs to write to HKLM. -->
    <CustomAction Id="SetRegisterTextService"
                  Property="WixQuietExec64CmdLine"
                  Value="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[INSTALLFOLDER]RustMagicTSF.dll&quot;"
                  Execute="immediate" />
    <CustomAction Id="RegisterTextService"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="SetUnregisterTextService"
                  Property="WixQuietExec64CmdLine"
                  Value="&quot;[SystemFolder]regsvr32.exe&quot; /u /s &quot;[INSTALLFOLDER]RustMagicTSF.dll&quot;"
                  Execute="immediate" />
    <CustomAction Id="UnregisterTextService"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetRegisterTextService" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="RegisterTextService" After="SetRegisterTextService">NOT REMOVE</Custom>
      <Custom Action="SetUnregisterTextService" Before="RemoveFiles">REMOVE~="ALL"</Custom>
      <Custom Action="UnregisterTextService" After="SetUnregisterTextService">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_InstallDir" />
  </Product>
</Wix>
